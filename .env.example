# Copie ce fichier en .env et remplis tes valeurs. Ne jamais committer .env.

# --- IBKR Web API (Client Portal) ---
# Compte paper (format DU…). OPTIONNEL : auto-découvert depuis le gateway si laissé tel quel.
IBKR_ACCOUNT_ID=DU0000000

# Identifiants IBeam — UNIQUEMENT pour l'option Docker (gateway/docker-compose.yml).
# Inutiles si tu utilises le Client Portal Gateway Java. Pour un compte PAPER, login paper.
IBEAM_ACCOUNT=your_ibkr_username
IBEAM_PASSWORD=your_ibkr_password

# Paths
DATA_DIR=./data
LOG_DIR=./logs

# Environment
ENV=development
